# Phase 0 reads a local dataset. No wearable API keys are required.
EVYZ_DATA_DIR=data/raw/wearableqa

# Leave these unset until that person connects. Never commit a real token.
# Oura: personal access token, daily scope only.
OURA_ACCESS_TOKEN=
# WHOOP: read:recovery and read:sleep only.
WHOOP_ACCESS_TOKEN=
# Fitbit: heart rate, HRV, sleep, breathing rate, temperature, activity.
FITBIT_ACCESS_TOKEN=
# Garmin Health API, after the developer program grants access.
GARMIN_ACCESS_TOKEN=
